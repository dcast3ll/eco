---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import IconPill from './ui/IconPill.astro';
import HeroImage from '../assets/images/hero.jpg';
---

<section id="inicio" class="relative overflow-hidden bg-surface">
  <div
    class="pointer-events-none absolute -right-40 -top-40 size-[34rem] rounded-full bg-olive-200/40 blur-3xl dark:bg-olive-500/10"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-48 -left-32 size-[28rem] rounded-full bg-terracotta-100/50 blur-3xl dark:bg-terracotta-500/10"
    aria-hidden="true"
  >
  </div>

  <Container class="relative">
    <div class="grid items-center gap-12 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-accent-line bg-surface-raised px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-link">
          <Icon name="lucide:recycle" class="size-3.5" aria-hidden="true" />
          Contenedores reciclados · 100% habitables
        </p>

        <h1
          class="mt-6 font-display text-4xl font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-6xl"
        >
          Tu casa propia, <span class="text-link">ecológica</span> y lista para habitar.
        </h1>

        <p class="prose-measure mt-6 text-lg leading-relaxed">
          Viviendas modulares en contenedores reciclados. Espacios inteligentes, diseño
          moderno y <strong class="font-semibold text-ink">100% autosuficientes</strong>.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <IconPill icon="lucide:sun" label="Paneles solares incluidos" />
          <IconPill icon="lucide:droplets" label="Tanques de agua de respaldo" />
        </div>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href="#modelos" size="lg" icon="lucide:arrow-right">Ver Modelos Disponibles</Button>
          <Button href="#contacto" size="lg" variant="secondary" icon="lucide:calendar" iconPosition="left">
            Agendar Visita
          </Button>
        </div>

        <div class="mt-9 flex items-center gap-4 border-t border-line pt-6">
          <div class="hidden -space-x-2 sm:flex" aria-hidden="true">
            {
              ['A', 'M', 'C', 'D'].map((initial, index) => (
                <span
                  class:list={[
                    'grid size-9 place-items-center rounded-full border-2 border-surface text-xs font-semibold text-cream-50',
                    index % 2 === 0 ? 'bg-olive-600' : 'bg-terracotta-500',
                  ]}
                >
                  {initial}
                </span>
              ))
            }
          </div>
          <div class="text-sm leading-snug">
            <p class="flex items-center gap-1 font-semibold text-ink">
              <Icon name="lucide:star" class="size-4 text-terracotta-500" aria-hidden="true" />
              4,9 / 5
              <span class="font-normal text-ink-subtle">en 126 proyectos entregados</span>
            </p>
            <p class="text-ink-subtle">Familias que ya viven en su propio terreno.</p>
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="overflow-hidden rounded-[2rem] border border-line bg-surface-muted shadow-2xl shadow-graphite-900/10 dark:shadow-black/40">
          <Image
            src={HeroImage}
            alt="Casa moderna de madera y líneas rectas integrada en un jardín arbolado"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] h-full w-full object-cover"
          />
        </div>

        <div
          class="absolute -bottom-6 left-4 flex items-center gap-3 rounded-2xl border border-line bg-surface-raised/95 p-4 shadow-xl shadow-graphite-900/10 backdrop-blur sm:left-8"
        >
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-accent-soft text-link">
            <Icon name="lucide:timer" class="size-5" aria-hidden="true" />
          </span>
          <div class="leading-tight">
            <p class="text-sm font-semibold text-ink">Entrega en 45 días</p>
            <p class="text-xs text-ink-subtle">Transporte e instalación incluidos</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
