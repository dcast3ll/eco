---
import { Icon } from 'astro-icon/components';
import Container from './ui/Container.astro';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Button from './ui/Button.astro';
import { faqs, site } from '../data/site';
---

<Section id="faq" background="white">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <SectionHeading
          eyebrow="Preguntas frecuentes"
          title="Todo lo que necesitas saber antes de decidir"
          description="Resolvemos las dudas más comunes sobre terreno, transporte e instalación."
        />

        <div class="mt-8 rounded-3xl border border-line bg-surface-muted p-6">
          <p class="font-display text-lg font-semibold text-ink">¿Tienes otra duda?</p>
          <p class="mt-1 text-sm text-ink-muted">
            Escríbenos y te respondemos en menos de 24 horas hábiles.
          </p>
          <div class="mt-4 flex flex-col gap-2 text-sm">
            <a
              href={`mailto:${site.email}`}
              class="inline-flex items-center gap-2 font-medium text-link hover:text-link-hover"
            >
              <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
              {site.email}
            </a>
            <a
              href={site.phoneHref}
              class="inline-flex items-center gap-2 font-medium text-link hover:text-link-hover"
            >
              <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
              {site.phone}
            </a>
          </div>
          <div class="mt-5">
            <Button href="#contacto" variant="secondary" icon="lucide:arrow-right">Hablar con un asesor</Button>
          </div>
        </div>
      </div>

      <div class="divide-y divide-line border-y border-line">
        {
          faqs.map((faq, index) => (
            <details class="group py-5" open={index === 0}>
              <summary
                class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-medium text-ink transition-colors hover:text-link [&::-webkit-details-marker]:hidden"
              >
                <span>{faq.question}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="size-5 shrink-0 text-link transition-transform duration-300 group-open:rotate-180"
                  aria-hidden="true"
                />
              </summary>
              <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink-muted">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </Container>
</Section>
