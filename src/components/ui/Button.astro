---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'light';
  size?: 'md' | 'lg';
  icon?: string;
  iconPosition?: 'left' | 'right';
  type?: 'button' | 'submit';
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'right',
  type = 'button',
  class: className = '',
  ariaLabel,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors duration-200 disabled:cursor-not-allowed disabled:opacity-60';

const variants = {
  primary: 'bg-olive-600 text-cream-50 shadow-sm hover:bg-olive-700 dark:hover:bg-olive-500',
  secondary:
    'border border-line-strong bg-surface-raised text-ink hover:border-olive-600 hover:text-link dark:hover:border-olive-400',
  ghost: 'text-ink-muted hover:bg-surface-muted hover:text-link',
  light: 'bg-cream-50 text-olive-700 shadow-sm hover:bg-cream-200',
};

const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-6 py-3.5 text-base',
};

const classes = [base, variants[variant], sizes[size], className];
---

{
  href ? (
    <a href={href} class:list={classes} aria-label={ariaLabel}>
      {icon && iconPosition === 'left' && <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />}
      <slot />
      {icon && iconPosition === 'right' && <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />}
    </a>
  ) : (
    <button type={type} class:list={classes} aria-label={ariaLabel}>
      {icon && iconPosition === 'left' && <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />}
      <slot />
      {icon && iconPosition === 'right' && <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />}
    </button>
  )
}
