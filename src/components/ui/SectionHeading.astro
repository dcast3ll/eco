---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  tone = 'dark',
  class: className = '',
} = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]}>
  {
    eyebrow && (
      <p
        class:list={[
          'text-sm font-semibold uppercase tracking-[0.2em]',
          tone === 'light' ? 'text-terracotta-300' : 'text-terracotta-700 dark:text-terracotta-300',
        ]}
      >
        {eyebrow}
      </p>
    )
  }
  <h2
    class:list={[
      'font-display text-3xl font-semibold tracking-tight sm:text-4xl lg:text-[2.75rem] lg:leading-[1.15]',
      tone === 'light' ? 'text-cream-50' : 'text-ink',
      eyebrow && 'mt-3',
    ]}
  >
    {title}
  </h2>
  {
    description && (
      <p
        class:list={[
          'mt-4 text-base leading-relaxed sm:text-lg',
          tone === 'light' ? 'text-cream-200' : 'text-ink-muted',
        ]}
      >
        {description}
      </p>
    )
  }
</div>
