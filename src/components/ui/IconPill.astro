---
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string;
  label: string;
  class?: string;
}

const { icon, label, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-full border border-accent-line bg-accent-soft px-3.5 py-1.5 text-sm font-medium text-link',
    className,
  ]}
>
  <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />
  {label}
</span>
