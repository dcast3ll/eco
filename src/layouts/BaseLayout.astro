---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'EcoContainers — Tu casa propia, ecológica y lista para habitar',
  description = 'Viviendas modulares construidas con contenedores marítimos reciclados. Diseño moderno, paneles solares integrados y reserva de agua inteligente.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2D5A27" />
    <script is:inline>
      try {
        if (localStorage.getItem('ecocontainers-theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
      } catch (error) {
        /* Storage can be blocked; fall back to the light theme. */
      }
    </script>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only rounded-full bg-olive-700 px-4 py-2 text-cream-50 focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
